{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^4.2",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "mpociot/versionable": "^4.4",
        "owen-it/laravel-auditing": "^14.0",
        "tightenco/ziggy": "^2.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "barryvdh/laravel-ide-helper": "^3.1",
        "fakerphp/faker": "^1.23",
        "laravel-lang/lang": "^15.29",
        "laravel-lang/publisher": "^16.8",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "11.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-b41t-wbzk-9q51": "TokenGuard bypass (critical): not exploitable, only the session guard is used, no token/api guard. Laravel 11 is EOL: fixed only in 12.x. Accepted until the Laravel 12 upgrade, see docs/upgrade-php84.md",
                    "PKSA-3r5d-mb8f-1qw9": "CRLF in email rule (high): email rule used in login and certified_email. Laravel 11 is EOL: fixed only in 12.x. Accepted until the Laravel 12 upgrade, see docs/upgrade-php84.md",
                    "PKSA-mdq4-51ck-6kdq": "CRLF in email rule, CVE-2026-48019 (high): same as PKSA-3r5d-mb8f-1qw9. Laravel 11 is EOL: fixed only in 12.x. Accepted until the Laravel 12 upgrade, see docs/upgrade-php84.md",
                    "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion (medium): only the email verification route is signed. Laravel 11 is EOL: fixed only in 12.x. Accepted until the Laravel 12 upgrade, see docs/upgrade-php84.md",
                    "PKSA-d5tc-s1qs-h781": "XSS in debug page (low): APP_DEBUG=false in production. Laravel 11 is EOL: fixed only in 12.x. Accepted until the Laravel 12 upgrade, see docs/upgrade-php84.md"
                }
            }
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
